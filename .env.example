# ==============================================================================
# Tickmark Configuration Example
# Copy this file to .env and fill in your values
# ==============================================================================

# Google Gemini API Key (Get free at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to gemini-flash-latest)
TICKMARK_MODEL=google_genai:gemini-flash-latest

# Rate limit for free tiers (e.g. 8 requests per minute)
# TICKMARK_RPM=8

# Concurrency (number of parallel exception resolution agents)
# TICKMARK_MAX_CONCURRENCY=4
